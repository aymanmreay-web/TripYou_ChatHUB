{
  "name": "tripyou-chathub-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace=apps/hub-web run dev",
    "build": "npm --workspace=apps/hub-web run build",
    "start": "npm --workspace=apps/hub-web run start",
    "test:permissions": "node tests/permissions/build.mjs && node tests/permissions/test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
